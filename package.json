{
  "name": "http-sequence-logger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Structured mobile HTTP and handler logging with a local sequence viewer",
  "scripts": {
    "generate": "node scripts/build-schema.mjs && node scripts/build-validator.mjs && node scripts/build-examples.mjs",
    "validate": "node validate.mjs examples/*.ndjson",
    "test": "node --test test/*.test.mjs",
    "viewer": "vite --config viewer/vite.config.mjs",
    "build:viewer": "vite build --config viewer/vite.config.mjs",
    "preview:viewer": "vite preview --config viewer/vite.config.mjs",
    "collector": "node collector/cli.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/source-code-pro": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1"
  }
}
