{
  "name": "http-sequence-logger",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Structured mobile and browser HTTP and handler logging with a local sequence viewer",
  "scripts": {
    "start": "node collector/cli.mjs --open",
    "android:live": "node scripts/android-live.mjs",
    "generate": "node scripts/build-schema.mjs && node scripts/build-validator.mjs && node scripts/build-diff-schema.mjs && node scripts/build-examples.mjs",
    "generate:diff": "node scripts/build-diff-schema.mjs",
    "diff:sequence": "node sequence-diff/cli.mjs",
    "validate": "node validate.mjs examples/*.ndjson",
    "test": "node --test test/*.test.mjs",
    "viewer": "vite --config viewer/vite.config.mjs",
    "build:viewer": "vite build --config viewer/vite.config.mjs",
    "preview:viewer": "vite preview --config viewer/vite.config.mjs",
    "check:svg-export": "node scripts/check-svg-export.mjs",
    "check:comparison": "node scripts/check-comparison.mjs",
    "check:live-setup": "node scripts/check-live-setup.mjs",
    "collector": "node collector/cli.mjs",
    "web:sample": "vite --config web-sample/vite.config.mjs",
    "build:web-sample": "vite build --config web-sample/vite.config.mjs",
    "check:web-release": "node scripts/check-web-release.mjs",
    "check:web-types": "tsc --ignoreConfig --noEmit --strict --types node --module nodenext --target es2022 --lib es2022,dom,dom.iterable integration/web-consumer/check.mts",
    "check:web-browser": "npm run build:viewer && npm run build:web-sample && node scripts/check-web-browser.mjs",
    "check:web-https": "node scripts/check-web-https.mjs",
    "check:collector-capacity": "node scripts/check-collector-capacity.mjs",
    "check:web-capacity": "node scripts/check-web-capacity.mjs",
    "check:collector-disk-full": "node scripts/check-collector-disk-full.mjs",
    "check:viewer-realtime": "node scripts/check-viewer-realtime.mjs",
    "check:native-realtime": "node scripts/check-native-realtime.mjs",
    "check:web-storage-denied": "node scripts/check-web-storage-denied.mjs",
    "check:native-crash-stages": "node scripts/check-native-crash-stages.mjs",
    "check:collector-bonjour": "node scripts/check-collector-bonjour.mjs",
    "check:android-instrumentation": "node scripts/check-android-instrumentation.mjs",
    "check:native-installation-lifecycle": "node scripts/check-native-installation-lifecycle.mjs",
    "check:native-simulator-clone": "node scripts/check-native-simulator-clone.mjs",
    "check:native-os-restore": "node scripts/check-native-os-restore.mjs",
    "check:native-cold-boot": "node scripts/check-native-cold-boot.mjs",
    "check:mobile-chrome": "node scripts/check-mobile-chrome.mjs",
    "check:physical-android": "node scripts/check-physical-android.mjs",
    "check:viewer-distributed": "node scripts/check-viewer-distributed.mjs"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "dependencies": {
    "@fontsource/source-code-pro": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
