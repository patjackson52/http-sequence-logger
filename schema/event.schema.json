    "httpEnd": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "success",
            "http_error",
            "transport_error",
            "timeout",
            "cancelled",
            "unknown"
          ]
        },
        "application_outcome": {
          "enum": [
            "success",
            "error",
            "unknown"
          ]
        },
        "status_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ns": {
          "$ref": "#/$defs/ns"
        },
        "end_reason": {
          "enum": [
            "body_eof",
            "body_closed",
            "transport_failure",
            "cancelled",
            "observation_stopped"
